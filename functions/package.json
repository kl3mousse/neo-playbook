    "firebase-functions": "^6.1.1",
    "openai": "^4.104.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  },
  "private": true,
  "overrides": {
    "websocket-driver": ">=0.7.5"
  }
}
