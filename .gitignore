# ===========================
# ComboFox — root .gitignore
# ===========================

# ----- Secrets / local config -----
secrets.json
firebase-service-account.json
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# ----- Firebase -----
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# ----- Flutter / Dart -----
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
*.g.dart

# Symbolication & obfuscation
app.*.symbols
app.*.map.json

# Android Studio build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# ----- Firebase Functions -----
functions/node_modules/
functions/lib/

# ----- IDE / OS -----
.idea/
*.iml
.vscode/
.DS_Store
*.swp
*.log

# ----- Archived Python tree -----
# old/ is tracked as a historical archive; ignore only its caches
old/**/__pycache__/
old/output/
